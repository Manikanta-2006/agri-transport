# Production Environment Variables for Agri Transport

# Port provided automatically by Render or Railway
PORT=5001

# Production Environment flag (tells Express to serve compiled React app from client/dist)
NODE_ENV=production

# MongoDB Atlas connection string (Free cluster from mongodb.com)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/agri-transport?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/agri-transport?retryWrites=true&w=majority

# JWT Secret for securing user tokens (use a long, random string in production)
JWT_SECRET=super_secret_jwt_key_replace_this_with_a_secure_random_string

# Optional: Razorpay credentials for payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
